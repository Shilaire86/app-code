{
  "expo": {
    "name": "The Becoming Method",
    "slug": "becoming-method",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "becomingmethod",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1A1A1A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.thebecomingmethod.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1A1A1A"
      },
      "package": "com.thebecomingmethod.app",
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.ACTIVITY_RECOGNITION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow The Becoming Method to use your camera to track your evolution."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow The Becoming Method to access your photos to log your progress."
        }
      ],
      "expo-build-properties",
      "expo-audio",
      "@react-native-community/datetimepicker",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow The Becoming Method to track your location during outdoor runs, including while your screen is locked.",
          "locationWhenInUsePermission": "Allow The Becoming Method to track your location during outdoor runs.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "Allow The Becoming Method to access motion & fitness data to count your steps during outdoor runs."
        }
      ],
      "expo-task-manager"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b4f4a1ba-17c5-4f1c-8eb1-1e6ba5621d12"
      }
    }
  }
}
